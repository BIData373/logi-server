// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Category{
    id        Int        @id(map: "category_pkey") @default(autoincrement())
    name      String
    slug      String
    createdAt  DateTime  @default(now()) @map("created_at")
    createdBy  Int       @map("created_by")
    deletedAt  DateTime? @map("deleted_at")
    updatedAt  DateTime?  @map("updated_at")
    updatedBy   Int?  @map("updated_by")
    imageId     Int     @map("image_id")
    products    Product[]
    user      User     @relation(fields: [createdBy], references: [id], map: "category_created_by_fkey")
    image      Image     @relation(fields: [imageId], references: [id], map: "category_image_fkey")


@@map("category")



}